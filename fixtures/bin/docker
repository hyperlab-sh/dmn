#!/usr/bin/env bash
# Test stub: records its arguments (one invocation per line); prints nothing, so `ps`
# reports no existing container unless DOCKER_STUB_PS is set, which `ps` then echoes.
printf '%s\n' "$*" >>"${DOCKER_STUB_LOG:?DOCKER_STUB_LOG must be set}"
if [ "${1:-}" = "ps" ] && [ -n "${DOCKER_STUB_PS:-}" ]; then
	echo "$DOCKER_STUB_PS"
fi
exit 0
